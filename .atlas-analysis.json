  "keyFeatures": [
    "Create and list repair orders with customer deduplication",
    "Retrieve procedure logs for each repair",
    "Access quotes and their customer acceptance status",
    "List file attachments at repair and procedure level",
    "Read communications (sent/received emails) per repair",
    "Scoped API tokens with per-endpoint permission control",
    "Consistent JSON response envelope with pagination metadata"
  ],
